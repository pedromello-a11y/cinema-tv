+package com.nuvio.tv.ui.personal
+
+import com.nuvio.tv.domain.model.*
+import com.nuvio.tv.ui.screens.home.*
+import org.junit.Assert.*
+import org.junit.Test
+
+class CinemaBrowseExperienceTest {
+    private fun saved(id: String, type: String = "movie", at: Long = 1) = SavedLibraryItem(
+        id, type, "Title $id", "poster-$id", PosterShape.POSTER, "scene-$id", "Synopsis", "2026", 8f,
+        listOf("Drama"), "https://catalog.example", addedAt = at
+    )
+    private fun catalog(type: ContentType, id: String) = CatalogRow("fixture", "Fixture", "https://catalog.example", id, id, type,
+        items = listOf(saved(id, type.toApiString()).toMetaPreview()), hasMore = false)
+    private fun progress(id: String, type: String = "movie") = ContinueWatchingItem.InProgress(WatchProgress(
+        contentId = id, contentType = type, name = id, poster = "poster-$id", backdrop = null, logo = null,
+        videoId = id, season = if(type == "series") 1 else null, episode = if(type == "series") 1 else null,
+        episodeTitle = null, position = 60_000, duration = 120_000, lastWatched = 1
+    ))
+
+    @Test fun `discovery is type scoped and never replaces or duplicates personal home`() {
+        val state = HomeUiState(catalogRows = listOf(catalog(ContentType.MOVIE, "trending-film"), catalog(ContentType.SERIES, "trending-series")))
+        val library = PersonalLibraryState(items = listOf(saved("mine")), ready = true)
+        assertEquals(listOf("mine"), cinemaRows(state, 0, library).flatMap { it.titles }.map { it.id })
+        assertTrue(cinemaRows(state, 0).isEmpty())
+        assertEquals(listOf("trending-film"), cinemaRows(state, 1, library, section = CinemaBrowseSection.DISCOVER).flatMap { it.titles }.map { it.id })
+        assertEquals(listOf("trending-series"), cinemaRows(state, 2, library, section = CinemaBrowseSection.DISCOVER).flatMap { it.titles }.map { it.id })
+    }
+
+    @Test fun `resume queue and remaining watchlist do not repeat a movie or mutate priorities`() {
+        val library = PersonalLibraryState(items = listOf(saved("a"), saved("b"), saved("c", at = 2), saved("d", at = 3)), queueKeys = listOf("movie:a", "movie:b"), ready = true)
+        val rows = cinemaRows(HomeUiState(continueWatchingItems = listOf(progress("a"))), 1, library)
+        assertEquals(listOf("a"), rows[0].titles.map { it.id })
+        assertEquals(listOf("b"), rows[1].titles.map { it.id })
+        assertEquals(listOf("d", "c"), rows[2].titles.map { it.id })
+        assertEquals(listOf("movie:a", "movie:b"), library.queueKeys)
+    }
+
+    @Test fun `history keeps latest movie completion and allows a separate rewatch intention`() {
+        val library = PersonalLibraryState(items = listOf(saved("a", at = 30)), history = listOf(
+            WatchedItem("a", "movie", "Old", watchedAt = 10),
+            WatchedItem("b", "movie", "Other", watchedAt = 15),
+            WatchedItem("a", "movie", "Latest", watchedAt = 20),
+            WatchedItem("show", "series", "Show", season = 1, episode = 1, watchedAt = 40),
+            WatchedItem("invalid", "movie", "Episode", season = 1, episode = 1, watchedAt = 40)
+        ))
+        val titles = cinemaRows(HomeUiState(), 1, library, section = CinemaBrowseSection.HISTORY).single().titles
+        assertEquals(listOf("a", "b"), titles.map { it.id })
+        assertEquals("Latest", titles.first().name)
+        assertNull(titles.first().poster)
+        assertTrue(titles.all { it.resume == null && it.statusLabel!!.startsWith("Visto em ") })
+        assertEquals(listOf("a"), cinemaRows(HomeUiState(), 1, library).single().titles.map { it.id })
+    }
+
+    @Test fun `following states have their own shelves and pending episodes do not duplicate resume`() {
+        val statuses = listOf(PersonalSeriesStatus.PENDING, PersonalSeriesStatus.UP_TO_DATE, PersonalSeriesStatus.PAUSED, PersonalSeriesStatus.ENDED, PersonalSeriesStatus.STOPPED)
+        val summaries = statuses.map { status ->
+            val entry = PersonalSeriesEntry(saved(status.name, "series"), when(status) { PersonalSeriesStatus.PAUSED -> PersonalSeriesMode.PAUSED; PersonalSeriesStatus.STOPPED -> PersonalSeriesMode.STOPPED; else -> PersonalSeriesMode.FOLLOWING }, followedAt = 1)
+            PersonalSeriesSummary(entry, status, pending = if(status == PersonalSeriesStatus.PENDING) listOf(PersonalEpisode("ep", 1, 1, "Pilot", "2026-01-01")) else emptyList())
+        }
+        val series = PersonalSeriesUiState(PersonalSeriesSnapshot(entries = summaries.map { it.entry }, ready = true), summaries)
+        val state = HomeUiState(continueWatchingItems = listOf(progress("PENDING", "series"), progress("PAUSED", "series")))
+        val rows = cinemaRows(state, 2, series = series)
+        assertEquals(listOf("Continuar assistindo", "Em dia", "Pausadas", "Concluídas"), rows.map { it.name })
+        assertEquals(listOf("PENDING", "UP_TO_DATE", "PAUSED", "ENDED"), rows.flatMap { it.titles }.map { it.id })
+        assertEquals(listOf("PENDING"), cinemaRows(state, 0, series = series).flatMap { it.titles }.map { it.id })
+    }
+
+    @Test fun `saved series remain separate from following and films`() {
+        val library = PersonalLibraryState(items = listOf(saved("film"), saved("show", "series")))
+        assertEquals(listOf("show"), cinemaRows(HomeUiState(), 2, library, section = CinemaBrowseSection.SAVED).single().titles.map { it.id })
+        assertTrue(cinemaRows(HomeUiState(), 2, library).isEmpty())
+        assertEquals("Descobrir séries", cinemaEmptyState(2, CinemaBrowseSection.PERSONAL, false, true).action)
+        assertEquals("Gerenciar add-ons", cinemaEmptyState(1, CinemaBrowseSection.DISCOVER, false, false).action)
+    }
+}
