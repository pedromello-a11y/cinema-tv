+/* DOM contract tests. Install jsdom@26.1.0 outside the Android app, then set NODE_PATH. */
+const fs = require('node:fs');
+const path = require('node:path');
+const assert = require('node:assert/strict');
+const { JSDOM, VirtualConsole } = require('jsdom');
+
+(async () => {
+  const item = (id, type = 'movie') => ({ id, type, name: 'Título ' + id });
+  const state = {
+    version: 'test', availableMB: 300,
+    library: { items: [item('a'), item('b'), item('c'), item('show', 'series')], queueKeys: ['movie:a', 'movie:b'] },
+    series: { ready: true, entries: [] }, history: [{ ...item('seen'), watchedAt: 1 }], searchResults: []
+  };
+  const posts = [], errors = [];
+  let rejectAction = false;
+  const virtualConsole = new VirtualConsole().on('jsdomError', error => errors.push(error.message));
+  const dom = new JSDOM(fs.readFileSync(path.join(__dirname, '../app/src/main/assets/personal/phone.html'), 'utf8'), {
+    url: 'https://cinema.test/', runScripts: 'dangerously', pretendToBeVisual: true, virtualConsole,
+    beforeParse(window) {
+      window.HTMLDialogElement.prototype.showModal = function () { this.open = true; };
+      window.HTMLDialogElement.prototype.close = function () { this.open = false; };
+      window.fetch = async (url, options) => {
+        assert.equal(options.headers['X-Cinema-Token'], '__PAIRING_TOKEN__');
+        if (url === '/api/state') return { ok: true, json: async () => JSON.parse(JSON.stringify(state)) };
+        assert.equal(url, '/api/action');
+        const body = JSON.parse(options.body);
+        if (rejectAction) return { ok: false, json: async () => ({ error: 'TV indisponível. Tente novamente.' }) };
+        posts.push(body);
+        if (body.action === 'move') {
+          const keys = state.library.queueKeys;
+          keys.splice(body.position, 0, keys.splice(keys.indexOf('movie:' + body.id), 1)[0]);
+        }
+        if (body.action === 'followSaved') state.series.entries.push({ item: item('show', 'series'), mode: 'FOLLOWING', label: '1 episódio pendente' });
+        if (body.action === 'saveWatched') state.library.items.push(item('seen'));
+        return { ok: true, json: async () => ({ ok: true }) };
+      };
+    }
+  });
+  try {
+    const document = dom.window.document;
+    const $ = selector => document.querySelector(selector);
+    const $$ = selector => [...document.querySelectorAll(selector)];
+    const click = (scope, label) => { const b = [...$(scope).querySelectorAll('button')].find(b => b.textContent === label); assert.ok(b, label); b.click(); };
+    const flush = () => new Promise(resolve => setImmediate(resolve));
+    await flush();
+    assert.equal($$('#queue article').length, 2);
+    assert.equal($$('#watchlist article').length, 1);
+    assert.equal($('[data-panel="series"]').hidden, true);
+    click('#queue article', 'Mover'); $('#position').value = '1'; $('#cancelmove').click();
+    assert.equal(posts.length, 0); assert.equal($('#mover').open, false);
+    click('#queue article', 'Mover'); $('#position').value = '1';
+    $('#moveform').dispatchEvent(new dom.window.Event('submit', { cancelable: true })); await flush();
+    assert.deepEqual(posts[0], { action: 'move', id: 'a', type: 'movie', position: 1 });
+    assert.deepEqual(state.library.queueKeys, ['movie:b', 'movie:a']);
+    assert.equal($('#queue article h3').textContent, 'Título b');
+    $('[data-tab="series"]').click(); assert.equal($('[data-panel="movies"]').hidden, true);
+    click('#savedseries', 'Acompanhar'); await flush();
+    assert.ok($('#series').textContent.includes('1 episódio pendente')); assert.equal(posts.at(-1).action, 'followSaved');
+    $('[data-tab="history"]').click(); assert.equal($('#search').hidden, true);
+    click('#history', 'Salvar para rever'); await flush(); assert.equal(posts.at(-1).action, 'saveWatched');
+    $('[data-tab="movies"]').click(); assert.equal($$('#watchlist article').length, 2);
+    const focus = $('#queue article button'); focus.focus(); await dom.window.refresh();
+    assert.equal(document.activeElement, focus);
+    rejectAction = true; click('#watchlist article', 'Próximos da fila'); await flush();
+    assert.equal($('#status').textContent, 'TV indisponível. Tente novamente.');
+    assert.equal($$('#watchlist article').length, 2); assert.equal(focus.disabled, false);
+    assert.deepEqual(errors, []);
+    console.log('PASS: 8 contratos DOM — seções, listas distintas, cancelamento, movimento, acompanhamento, rever, foco após atualização e erro sem perda de dados.');
+  } finally { dom.window.close(); }
+})().catch(error => { console.error(error); process.exitCode = 1; });
