+/** Move once, preserving all other priorities and adapting to a concurrently shortened queue. */
+fun movePersonalQueueTo(keys: List<String>, key: String, targetIndex: Int): List<String> {
+    val from = keys.indexOf(key)
+    if (from < 0 || targetIndex < 0) return keys
+    val to = targetIndex.coerceAtMost(keys.lastIndex)
+    return keys.toMutableList().apply { add(to, removeAt(from)) }
+}
