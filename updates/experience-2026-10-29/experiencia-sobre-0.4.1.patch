+/** Preview locally; only Confirm writes the new priority. Back/Cancel preserve the queue. */
+@Composable
+internal fun CinemaQueuePositionDialog(title: CinemaTitle, library: PersonalLibraryState, position: Int, onConfirm: (Int) -> Unit, onDismiss: () -> Unit) {
+    var target by remember(title.key) { mutableIntStateOf(position) }
+    val last = library.queueKeys.lastIndex.coerceAtLeast(0)
+    val first = remember { FocusRequester() }
+    val firstAction = remember { FocusRequester() }
+    val lastAction = remember { FocusRequester() }
+    val saveAction = remember { FocusRequester() }
+    val cancelAction = remember { FocusRequester() }
+    LaunchedEffect(last) { target = target.coerceIn(0, last) }
+    Dialog(onDismissRequest = onDismiss, properties = DialogProperties(usePlatformDefaultWidth = false)) {
+        val input = LocalInputModeManager.current
+        val window = LocalWindowInfo.current
+        LaunchedEffect(window.isWindowFocused) {
+            if(window.isWindowFocused) { input.requestInputMode(InputMode.Keyboard); withFrameNanos { }; first.requestFocus() }
+        }
+        Column(Modifier.width(460.dp).background(CinemaStyle.Surface, RoundedCornerShape(20.dp)).padding(28.dp), verticalArrangement = Arrangement.spacedBy(16.dp)) {
+            Text("Mover na fila", fontFamily = CinemaDisplay, fontSize = 28.sp, color = CinemaStyle.Ink)
+            Text(title.name, fontFamily = CinemaUi, fontSize = 15.sp, color = CinemaStyle.Muted, maxLines = 2, overflow = TextOverflow.Ellipsis)
+            var focused by remember { mutableStateOf(false) }
+            Text("Posição ${target + 1} de ${last + 1}", fontFamily = CinemaDisplay, fontSize = 26.sp, color = CinemaStyle.Green,
+                modifier = Modifier.fillMaxWidth().testTag("queue-position").focusRequester(first)
+                    .focusProperties { down = firstAction; up = FocusRequester.Cancel }
+                    .onFocusChanged { focused = it.isFocused }
+                    .onPreviewKeyEvent { event ->
+                        if(event.type != KeyEventType.KeyDown) false else when(event.key) {
+                            Key.DirectionLeft -> { target = (target - 1).coerceAtLeast(0); true }
+                            Key.DirectionRight -> { target = (target + 1).coerceAtMost(last); true }
+                            else -> false
+                        }
+                    }.semantics {
+                        stateDescription = "Posição ${target + 1} de ${last + 1}"
+                        progressBarRangeInfo = ProgressBarRangeInfo(target.toFloat(), 0f..last.toFloat(), (last - 1).coerceAtLeast(0))
+                        setProgress { value -> target = value.toInt().coerceIn(0, last); true }
+                    }.focusable().border(if(focused) 2.dp else 1.dp, if(focused) CinemaStyle.Green else CinemaStyle.Outline, RoundedCornerShape(12.dp)).padding(16.dp))
+            val reordered = movePersonalQueueTo(library.queueKeys, title.key, target)
+            val nextName = reordered.getOrNull(target + 1)?.let { key -> library.items.firstOrNull { "${it.type}:${it.id}" == key }?.name }
+            Text(if(nextName != null) "Antes de $nextName" else "Último da fila", fontFamily = CinemaUi, fontSize = 13.sp, color = CinemaStyle.Muted, maxLines = 1, overflow = TextOverflow.Ellipsis)
+            Text("Use ← → para escolher. A ordem muda somente ao salvar.", fontFamily = CinemaUi, fontSize = 12.sp, color = CinemaStyle.Muted)
+            Row(horizontalArrangement = Arrangement.spacedBy(10.dp)) {
+                CinemaAction("Primeiro", false, Modifier.focusRequester(firstAction).focusProperties {
+                    up = first; down = saveAction; right = lastAction; left = FocusRequester.Cancel
+                }) { target = 0 }
+                CinemaAction("Último", false, Modifier.focusRequester(lastAction).focusProperties {
+                    up = first; down = cancelAction; left = firstAction; right = FocusRequester.Cancel
+                }) { target = last }
+            }
+            Row(horizontalArrangement = Arrangement.spacedBy(10.dp)) {
+                CinemaAction("Salvar posição", true, Modifier.testTag("queue-position-save").focusRequester(saveAction).focusProperties {
+                    up = firstAction; right = cancelAction; left = FocusRequester.Cancel; down = FocusRequester.Cancel
+                }) { onConfirm(target) }
+                CinemaAction("Cancelar", false, Modifier.focusRequester(cancelAction).focusProperties {
+                    up = lastAction; left = saveAction; right = FocusRequester.Cancel; down = FocusRequester.Cancel
+                }, onClick = onDismiss)
+            }
+        }
+    }
+}
