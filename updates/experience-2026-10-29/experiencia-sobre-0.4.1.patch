+package com.nuvio.tv.ui.personal
+
+internal enum class CinemaBrowseSection { PERSONAL, SAVED, DISCOVER, HISTORY }
+
+internal fun cinemaSections(tab: Int): List<Pair<CinemaBrowseSection, String>> = when(tab) {
+    1 -> listOf(CinemaBrowseSection.PERSONAL to "Quero ver", CinemaBrowseSection.DISCOVER to "Descobrir", CinemaBrowseSection.HISTORY to "Histórico")
+    2 -> listOf(CinemaBrowseSection.PERSONAL to "Acompanhando", CinemaBrowseSection.SAVED to "Quero ver", CinemaBrowseSection.DISCOVER to "Descobrir")
+    else -> emptyList()
+}
+
+internal data class CinemaEmptyState(val title: String, val description: String, val action: String)
+internal fun cinemaEmptyState(tab: Int, section: CinemaBrowseSection, loading: Boolean, hasCatalogs: Boolean): CinemaEmptyState = when {
+    loading -> CinemaEmptyState("Preparando sua sessão", "Suas listas e episódios estão sendo carregados.", "Buscar um título")
+    section == CinemaBrowseSection.DISCOVER && !hasCatalogs -> CinemaEmptyState("Nenhum catálogo disponível", "Confira seus add-ons ou tente carregar novamente.", "Gerenciar add-ons")
+    section == CinemaBrowseSection.DISCOVER -> CinemaEmptyState("Nada nesta categoria por enquanto", "Você pode buscar um título ou revisar os catálogos instalados.", "Buscar um título")
+    section == CinemaBrowseSection.HISTORY -> CinemaEmptyState("Seu histórico começa aqui", "Os filmes concluídos aparecem aqui, mesmo depois de sair de Quero ver.", "Descobrir filmes")
+    tab == 2 && section == CinemaBrowseSection.SAVED -> CinemaEmptyState("Séries para mais tarde", "Salve uma série em Quero ver. Quando decidir acompanhar, ela terá episódios e agenda próprios.", "Descobrir séries")
+    tab == 2 -> CinemaEmptyState("Escolha suas próximas séries", "Use Acompanhar para reunir episódios pendentes, séries em dia e pausadas.", "Descobrir séries")
+    tab == 1 -> CinemaEmptyState("O que você quer ver?", "Salve filmes em Quero ver e escolha os prioritários para Próximos da fila.", "Descobrir filmes")
+    else -> CinemaEmptyState("Seu próximo momento de cinema", "Continue filmes e séries por aqui. Suas escolhas ficam em Filmes e Séries.", "Explorar filmes")
+}
