+package com.nuvio.tv.ui.personal
+
+import com.nuvio.tv.domain.model.SavedLibraryItem
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.ensureActive
+import org.json.JSONArray
+import org.json.JSONObject
+
+internal class LetterboxdSyncEngine(
+    private val store: LetterboxdSyncStore,
+    private val remote: LetterboxdRemote,
+    private val profile: Int,
+    private val allowed: () -> Boolean,
+    private val importLists: suspend (List<SavedLibraryItem>, List<SavedLibraryItem>) -> Unit,
+    private val now: () -> Long = System::currentTimeMillis
+) {
+    private suspend fun call(op: String, build: JSONObject.() -> Unit = {}): JSONObject {
+        currentCoroutineContext().ensureActive()
+        check(allowed()) { "A sincronização foi pausada ou o perfil mudou." }
+        return remote.call(JSONObject().put("op", op).apply(build))
+    }
+    suspend fun sync() {
+        val identity = call("identity")
+        if (!identity.getString("username").equals(LETTERBOXD_ACCOUNT, true)) throw LetterboxdSyncFailure("wrong_account")
+        var hadPending = false
+        for (entry in store.pending(profile).filter { it.optLong("letterboxdRetryAt") <= now() }.take(12)) {
+            if (entry.optString("letterboxdStatus") in setOf("conflict", "identity", "format")) { hadPending = true; continue }
+            try { syncEntry(entry) }
+            catch (cancelled: CancellationException) { throw cancelled }
+            catch (error: LetterboxdSyncFailure) {
+                entry.put("letterboxdStatus", error.code).put("letterboxdMessage", letterboxdSyncMessage(error.code))
+                    .put("letterboxdRetryAt", now() + 30 * 60_000); store.update(entry)
+                if (error.code in setOf("conflict", "identity", "format", "uncertain")) hadPending = true else throw error
+            }
+        }
+        val shouldImport = now() - store.state().lastImport >= 6 * 60 * 60_000L || store.state().lastImport == 0L
+        if (shouldImport) importSnapshot()
+        store.success(now(), shouldImport)
+        if (hadPending || store.pending(profile).isNotEmpty()) store.message("Sincronização conferida. Há registros pendentes; veja o estado de cada filme abaixo.")
+    }
+    private suspend fun syncEntry(entry: JSONObject) {
+        val id = entry.getString("contentId")
+        if (letterboxdLookupUrl(id) == null) throw LetterboxdSyncFailure("identity")
+        val film = call("resolve") { put("contentId", id) }
+        val lid = film.getString("lid")
+        val date = letterboxdEntryDate(entry)
+        val half = if (entry.isNull("halfStars")) null else entry.getInt("halfStars").also { if (it !in 1..10) throw LetterboxdSyncFailure("format") }
+        val before = call("state") { put("lid", lid) }
+        var logs = call("diary") { put("lid", lid); put("date", date) }.getJSONArray("entries")
+        if (logs.length() == 0 && !entry.optBoolean("letterboxdDiaryAttempted")) {
+            // Durable before POST: after a timeout or process death, reconcile instead of POSTing again.
+            entry.put("watchedDate", date).put("letterboxdDiaryAttempted", true).put("letterboxdStatus", "awaiting_verification")
+            store.update(entry)
+            call("createDiary") { put("lid", lid); put("date", date); put("halfStars", half ?: JSONObject.NULL); put("rewatch", before.getBoolean("watched")) }
+            logs = call("diary") { put("lid", lid); put("date", date) }.getJSONArray("entries")
+        }
+        if (logs.length() == 0) throw LetterboxdSyncFailure("uncertain")
+        val matches = (0 until logs.length()).map { logs.getJSONObject(it) }.filter {
+            it.getString("date") == date && (if (it.isNull("halfStars")) null else it.getInt("halfStars")) == half
+        }
+        if (matches.size != 1) throw LetterboxdSyncFailure("conflict")
+        val receipt = matches.single().getString("id")
+        if (store.receiptUsed(receipt, entry.getString("sessionId"))) throw LetterboxdSyncFailure("conflict")
+        if (!before.getBoolean("watched")) call("watch") { put("lid", lid) }
+        if (half != null && (before.isNull("halfStars") || before.getInt("halfStars") != half)) call("rate") { put("lid", lid); put("halfStars", half) }
+        val after = call("state") { put("lid", lid) }
+        if (!after.getBoolean("watched") || (half != null && (after.isNull("halfStars") || after.getInt("halfStars") != half))) throw LetterboxdSyncFailure("uncertain")
+        entry.put("letterboxdStatus", "synced").put("letterboxdDiaryId", receipt).put("letterboxdSyncedAt", now())
+            .put("letterboxdMessage", "Assistido, diário e nota conferidos no Letterboxd.")
+        store.update(entry)
+    }
+
+    private suspend fun importSnapshot() {
+        val ids = linkedSetOf<String>(); val cursors = mutableSetOf<String>(); var cursor: String? = null
+        do {
+            val page = call("watchlistPage") { cursor?.let { put("cursor", it) } }
+            val list = page.getJSONArray("ids")
+            for (i in 0 until list.length()) ids += list.getString(i)
+            if (ids.size > 2000) throw LetterboxdSyncFailure("limit")
+            cursor = page.optString("next").takeUnless { it.isBlank() || it == "null" }
+            if (cursor != null && (!cursors.add(cursor) || cursors.size > 40)) throw LetterboxdSyncFailure("incomplete")
+        } while (cursor != null)
+        val favoriteIds = call("favorites").getJSONArray("ids").let { a -> (0 until a.length()).map { a.getString(it) } }
+        if (favoriteIds.size > 4) throw LetterboxdSyncFailure("format")
+        val films = mutableMapOf<String, SavedLibraryItem>()
+        for (id in ids + favoriteIds) {
+            val details = store.cachedFilm(id, now()) ?: call("details") { put("lid", id) }.also { store.cacheFilm(id, it, now()) }
+            films[id] = importedLetterboxdFilm(details)
+        }
+        // Import only after every page and film identity has been validated. Never erase lists after a failed page.
+        val locallyCompleted = store.entries(profile).map { it.getString("contentId").removePrefix("imdb:") }.toSet()
+        val watchlist = ids.map { films.getValue(it) }.filter { it.id.removePrefix("imdb:") !in locallyCompleted }
+        if (!allowed()) throw CancellationException("Profile changed")
+        importLists(watchlist, favoriteIds.map { films.getValue(it) })
+    }
+}
