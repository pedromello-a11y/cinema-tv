+      return resolved;
+    }
+    if (command.op === 'state') return relationship(lid(command.lid), member);
+    if (command.op === 'watch' || command.op === 'rate') {
+      const id = lid(command.lid);
+      if (command.op === 'rate' && (!Number.isInteger(command.halfStars) || command.halfStars < 1 || command.halfStars > 10)) fail('format');
+      await request('/api/v0/me/' + (command.op === 'watch' ? 'watch/' : 'rate/') + id, 'PATCH',
+        command.op === 'watch' ? {watched:true} : {rating:command.halfStars / 2});
+      return relationship(id, member);
+    }
+    if (command.op === 'diary' || command.op === 'createDiary') {
+      const id = lid(command.lid), date = command.date;
+      if (!/^\d{4}-\d{2}-\d{2}$/.test(date || '')) fail('format');
+      if (command.op === 'createDiary') {
+        if (command.halfStars != null && (!Number.isInteger(command.halfStars) || command.halfStars < 1 || command.halfStars > 10)) fail('format');
+        const body = {productionId:id, diaryDetails:{diaryDate:date, rewatch:command.rewatch === true}};
+        if (command.halfStars != null) body.rating = command.halfStars / 2;
+        // No review, tags, visibility or likes are changed. The account's privacy default applies.
+        const result = await request('/api/v0/production-log-entries', 'POST', body);
+        return {id: (result.data || result).id || null};
+      }
+      const [year,month,day] = date.split('-');
+      const query = new URLSearchParams({film:id,member:member.id,memberRelationship:'Owner',year,month,day,perPage:'100',where:'HasDiaryDate'});
+      const result = await request('/api/v0/log-entries?' + query);
+      if (!Array.isArray(result.items) || result.next) fail('incomplete');
+      return {entries:result.items.map(entry => {
+        const film = entry.production || entry.film;
+        if (entry.owner?.id !== member.id || film?.id !== id || !entry.diaryDetails?.diaryDate) fail('format');
+        const rating = entry.rating;
+        if (rating != null && (typeof rating !== 'number' || rating < .5 || rating > 5 || rating * 2 % 1)) fail('format');
+        return {id:lid(entry.id), date:entry.diaryDetails.diaryDate, halfStars:rating == null ? null : rating * 2};
+      })};
+    }
+    if (command.op === 'watchlistPage') {
+      const query = new URLSearchParams({perPage:'50'});
+      if (command.cursor) { if (typeof command.cursor !== 'string' || command.cursor.length > 2048) fail('format'); query.set('cursor',command.cursor); }
+      const result = await request('/api/v0/member/' + member.id + '/watchlist?' + query);
+      if (!Array.isArray(result.items) || result.items.length > 50 || (result.next != null && typeof result.next !== 'string')) fail('format');
