+  }
+  function identifiers(film) {
+    let imdb = /^tt[0-9]{1,12}$/.test(film.imdbId || '') ? film.imdbId : null;
+    let tmdb = /^[0-9]{1,12}$/.test(String(film.tmdbId || '')) ? String(film.tmdbId) : null;
+    for (const link of film.links || []) {
+      try {
+        const url = new URL(link.url);
+        if (url.protocol !== 'https:') continue;
+        const i = /^(?:www\.)?imdb\.com$/.test(url.hostname) && /^\/title\/(tt[0-9]+)\/?$/.exec(url.pathname);
+        const t = /^(?:www\.)?themoviedb\.org$/.test(url.hostname) && /^\/movie\/([0-9]+)(?:-[^/]*)?\/?$/.exec(url.pathname);
