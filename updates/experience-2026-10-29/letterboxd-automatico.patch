+/* Cinema TV web-session adapter. No native bridge or credentials leave this origin. */
+(function () {
+  'use strict';
+  const origin = 'https://letterboxd.com';
+  const fail = (code, retryAfter = 0) => { throw Object.assign(new Error(code), {code, retryAfter}); };
+  const lid = value => { if (typeof value !== 'string' || !/^[A-Za-z0-9]{1,40}$/.test(value)) fail('format'); return value; };
+  function accessStatus(response) {
+    if (response.status === 401) fail('reconnect');
+    if (response.status === 403) fail('verification');
+    if (response.status === 429) {
+      const raw = response.headers.get('Retry-After'), seconds = Number(raw);
