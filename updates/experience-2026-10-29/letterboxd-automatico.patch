+package com.nuvio.tv.ui.personal
+
+import android.annotation.SuppressLint
+import android.content.Context
+import android.os.Build
+import android.webkit.*
+import kotlinx.coroutines.*
+import org.json.JSONObject
+import org.json.JSONTokener
+import java.util.UUID
+import kotlin.coroutines.resume
+
+internal class LetterboxdSyncFailure(val code: String, val retryAfterSeconds: Long = 0) : Exception(code)
+
+internal interface LetterboxdRemote {
+    suspend fun call(command: JSONObject): JSONObject
+}
+
+/** Exists only during a foreground synchronization, never alongside the player. */
+@SuppressLint("SetJavaScriptEnabled")
+internal class LetterboxdWebSession(private val context: Context) : LetterboxdRemote {
+    private var web: WebView? = null
+    private var ready: CompletableDeferred<Unit>? = null
+
+    suspend fun open() = withContext(Dispatchers.Main.immediate) {
+        if (Build.VERSION.SDK_INT >= 26 && WebView.getCurrentWebViewPackage() == null) throw LetterboxdSyncFailure("webview")
+        val loaded = CompletableDeferred<Unit>(); ready = loaded
+        web = WebView(context).apply {
+            settings.javaScriptEnabled = true
+            settings.domStorageEnabled = true
+            settings.cacheMode = WebSettings.LOAD_NO_CACHE
+            settings.allowFileAccess = false; settings.allowContentAccess = false
+            settings.mixedContentMode = WebSettings.MIXED_CONTENT_NEVER_ALLOW
+            settings.javaScriptCanOpenWindowsAutomatically = false
+            settings.setSupportMultipleWindows(false)
+            if (Build.VERSION.SDK_INT >= 26) settings.safeBrowsingEnabled = true
+            CookieManager.getInstance().setAcceptThirdPartyCookies(this, false)
+            webChromeClient = object : WebChromeClient() {
+                override fun onPermissionRequest(request: PermissionRequest) = request.deny()
+            }
+            webViewClient = object : WebViewClient() {
+                override fun shouldOverrideUrlLoading(view: WebView, request: WebResourceRequest): Boolean =
+                    if (request.isForMainFrame) !trustedLetterboxdUrl(request.url.toString()) else request.url.scheme != "https"
+                override fun onPageFinished(view: WebView, url: String?) {
+                    if (trustedLetterboxdUrl(url)) loaded.complete(Unit)
+                    else loaded.completeExceptionally(LetterboxdSyncFailure("origin"))
+                }
+                override fun onReceivedError(view: WebView, request: WebResourceRequest, error: WebResourceError) {
+                    if (request.isForMainFrame) loaded.completeExceptionally(LetterboxdSyncFailure("network"))
+                }
+                override fun onReceivedHttpError(view: WebView, request: WebResourceRequest, response: WebResourceResponse) {
+                    if (request.isForMainFrame) loaded.completeExceptionally(LetterboxdSyncFailure(if (response.statusCode == 403) "verification" else "network"))
+                }
+                override fun onRenderProcessGone(view: WebView, detail: RenderProcessGoneDetail): Boolean {
+                    web = null; view.destroy(); loaded.completeExceptionally(LetterboxdSyncFailure("webview")); return true
+                }
+            }
+            loadUrl("$LETTERBOXD_ORIGIN/")
+        }
+        withTimeout(30_000) { loaded.await() }
+        val script = withContext(Dispatchers.IO) { context.assets.open("personal/letterboxd-sync.js").bufferedReader().use { it.readText() } }
+        evaluate(script)
+    }
+
+    private suspend fun evaluate(script: String): String = withContext(Dispatchers.Main.immediate) {
+        val view = web ?: throw LetterboxdSyncFailure("webview")
+        if (!trustedLetterboxdUrl(view.url)) throw LetterboxdSyncFailure("origin")
+        withTimeout(5_000) {
+            suspendCancellableCoroutine { continuation ->
+                view.evaluateJavascript(script) { result -> if (continuation.isActive) continuation.resume(result ?: "null") }
+            }
+        }
+    }
+
+    override suspend fun call(command: JSONObject): JSONObject = withContext(Dispatchers.Main.immediate) {
+        val slot = "__cinema_" + UUID.randomUUID().toString().replace("-", "")
+        val payload = JSONObject.quote(command.toString())
+        evaluate("(function(){window['$slot']=null; window.CinemaLetterboxd.run(JSON.parse($payload)).then(function(v){window['$slot']=JSON.stringify({ok:true,data:v});},function(e){window['$slot']=JSON.stringify({ok:false,code:e.code||'network',retryAfter:e.retryAfter||0});});})()")
+        try {
+            withTimeout(65_000) {
+                while (true) {
+                    currentCoroutineContext().ensureActive()
+                    val raw = evaluate("window['$slot']")
+                    val value = runCatching { JSONTokener(raw).nextValue() as? String }.getOrNull()
+                    if (value != null) {
+                        if (value.length > 128 * 1024) throw LetterboxdSyncFailure("limit")
+                        val result = JSONObject(value)
+                        if (!result.optBoolean("ok")) throw LetterboxdSyncFailure(result.optString("code", "network"), result.optLong("retryAfter"))
+                        return@withTimeout result.getJSONObject("data")
+                    }
+                    delay(100)
+                }
+                @Suppress("UNREACHABLE_CODE") JSONObject()
+            }
+        } finally { withContext(NonCancellable) { runCatching { evaluate("delete window['$slot']") } } }
+    }
+
+    suspend fun close() = withContext(NonCancellable + Dispatchers.Main.immediate) {
+        web?.let { it.stopLoading(); it.clearCache(true); it.destroy() }
+        web = null; ready?.cancel(); ready = null
+        CookieManager.getInstance().flush()
+    }
