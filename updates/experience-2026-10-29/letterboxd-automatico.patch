+      if (!Array.isArray(member.favorites) || member.favorites.length > 4) fail('format');
+      return {ids:member.favorites.map(x => lid(typeof x === 'string' ? x : x.id))};
+    }
+    fail('operation');
+  }
+  window.CinemaLetterboxd = {run};
+})();
