+      accessStatus(response);
+      if (!response.ok) fail(response.status >= 500 ? 'network' : 'format');
+      if (response.status === 204) return {};
+      if (!/application\/json/i.test(response.headers.get('Content-Type') || '')) fail('verification');
+      const text = await response.text(); if (text.length > 1500000) fail('limit');
+      return JSON.parse(text);
+    } catch (error) { if (error.code) throw error; fail('network'); }
