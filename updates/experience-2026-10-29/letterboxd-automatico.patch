+package com.nuvio.tv.ui.personal
+
+import android.content.Context
+import android.content.SharedPreferences
+import com.nuvio.tv.domain.model.SavedLibraryItem
+import com.nuvio.tv.domain.model.PosterShape
+import kotlinx.coroutines.channels.awaitClose
+import kotlinx.coroutines.flow.callbackFlow
+import kotlinx.coroutines.flow.conflate
+import org.json.JSONObject
+import java.time.Instant
+import java.time.ZoneId
+
+internal data class LetterboxdSyncState(val enabled: Boolean, val profileId: Int, val message: String?, val lastSuccess: Long, val lastImport: Long, val retryAt: Long)
+internal class LetterboxdSyncStore(context: Context) {
+    private val prefs = context.getSharedPreferences("letterboxd_automation", Context.MODE_PRIVATE)
+    private val diary = context.getSharedPreferences("personal_diary", Context.MODE_PRIVATE)
+    private val metadata = context.getSharedPreferences("letterboxd_metadata", Context.MODE_PRIVATE)
+    fun cachedFilm(lid: String, now: Long): JSONObject? = runCatching {
+        val cached = JSONObject(metadata.getString(lid, null) ?: return null)
+        if (now - cached.getLong("time") >= 7 * 24 * 60 * 60_000L) return null
+        cached.getJSONObject("film").also { importedLetterboxdFilm(it) }
+    }.getOrNull()
+    fun cacheFilm(lid: String, film: JSONObject, now: Long) {
+        importedLetterboxdFilm(film)
+        require(lid.matches(Regex("[A-Za-z0-9]{1,40}")) && film.toString().length <= 4096)
+        val edit = metadata.edit()
+        if (!metadata.contains(lid) && metadata.all.size >= 2100) {
+            metadata.all.entries.sortedBy { runCatching { JSONObject(it.value as String).optLong("time") }.getOrDefault(0) }
+                .take(100).forEach { edit.remove(it.key) }
+        }
+        check(edit.putString(lid, JSONObject().put("time", now).put("film", film).toString()).commit())
+    }
+    fun state() = LetterboxdSyncState(prefs.getBoolean("enabled", false), prefs.getInt("profile", 1), prefs.getString("message", null),
+        prefs.getLong("success", 0), prefs.getLong("import", 0), prefs.getLong("retryAt", 0))
+    fun enable(profile: Int, enabled: Boolean) { check(prefs.edit().putBoolean("enabled", enabled).putInt("profile", profile).putLong("retryAt", 0)
+        .putString("message", if (enabled) "Sincronização automática ativada. A sessão será conferida antes de enviar." else "Sincronização pausada. Registros locais preservados.").commit()) }
+    fun retry() {
+        prefs.edit().putLong("retryAt", 0).putLong("import", 0).apply()
+        for (entry in pending(state().profileId)) {
+            entry.put("letterboxdStatus", "pending").put("letterboxdRetryAt", 0); update(entry)
+        }
+    }
+    fun message(value: String) { prefs.edit().putString("message", value).apply() }
+    fun success(now: Long, imported: Boolean) { val edit = prefs.edit().putLong("success", now).putLong("retryAt", 0).putInt("failures", 0)
+        .putString("message", "Última sincronização confirmada no Letterboxd."); if (imported) edit.putLong("import", now); edit.apply() }
+    fun failure(error: Throwable, now: Long) {
+        val code = (error as? LetterboxdSyncFailure)?.code ?: "network"
+        val count = (prefs.getInt("failures", 0) + 1).coerceAtMost(8)
+        val delay = maxOf((error as? LetterboxdSyncFailure)?.retryAfterSeconds?.times(1000) ?: 0,
+            if (code in setOf("reconnect", "wrong_account", "verification", "format", "webview")) 6 * 60 * 60_000L else (60_000L shl count).coerceAtMost(6 * 60 * 60_000L))
+        prefs.edit().putInt("failures", count).putLong("retryAt", now + delay).putString("message", letterboxdSyncMessage(code)).apply()
+    }
+    fun entries(profile: Int): List<JSONObject> = diary.all.values.mapNotNull { raw -> runCatching { JSONObject(raw as String) }.getOrNull() }
+        .filter { it.optInt("profileId", 1) == profile && it.optString("sessionId").isNotBlank() }
+        .sortedBy { it.optLong("watchedAt") }
+    fun pending(profile: Int) = entries(profile).filter { it.optString("letterboxdStatus") != "synced" && it.optString("letterboxdStatus") != "local_only" }
+    fun hasWork(profile: Int, now: Long): Boolean = state().lastImport == 0L || now - state().lastImport >= 6 * 60 * 60_000L ||
+        pending(profile).any { it.optString("letterboxdStatus") !in setOf("conflict", "identity", "format") && it.optLong("letterboxdRetryAt") <= now }
+    fun update(entry: JSONObject) { check(diary.edit().putString(entry.getString("sessionId"), entry.toString()).commit()) { "Não foi possível salvar o estado da sincronização." } }
+    fun receiptUsed(receipt: String, sessionId: String) = diary.all.values.any { raw -> runCatching { JSONObject(raw as String).let {
+        it.optString("sessionId") != sessionId && it.optString("letterboxdDiaryId") == receipt
+    } }.getOrDefault(false) }
+    fun observe() = callbackFlow {
+        val listener = SharedPreferences.OnSharedPreferenceChangeListener { _, _ -> trySend(Unit) }
+        prefs.registerOnSharedPreferenceChangeListener(listener); diary.registerOnSharedPreferenceChangeListener(listener); trySend(Unit)
+        awaitClose { prefs.unregisterOnSharedPreferenceChangeListener(listener); diary.unregisterOnSharedPreferenceChangeListener(listener) }
+    }.conflate()
+}
+
+internal fun letterboxdSyncMessage(code: String) = when(code) {
+    "reconnect" -> "Reconecte o Letterboxd. Seus registros continuam salvos para envio."
+    "wrong_account" -> "Entre com pedrovicq. Nenhum registro será enviado para outra conta."
+    "verification" -> "O Letterboxd pediu uma verificação. Abra Conectar e conclua a etapa no site."
+    "uncertain" -> "Envio ainda não confirmado. O app vai conferir novamente sem duplicar o diário."
+    "conflict" -> "Existe um registro diferente para esse filme e data. O app preservou o registro do Letterboxd."
+    "rate_limit" -> "O Letterboxd pediu uma pausa. A sincronização retomará após o intervalo indicado."
+    "identity" -> "Não foi possível confirmar a identidade de um filme. O registro local foi preservado."
+    "webview" -> "O componente web do Android não ficou disponível. Seus registros estão preservados."
+    "format", "incomplete", "limit", "origin" -> "A resposta do Letterboxd não pôde ser validada. Listas e registros anteriores foram preservados."
+    else -> "Sem conexão com o Letterboxd agora. O app tentará novamente sem perder seus registros."
+}
+
+internal fun letterboxdEntryDate(entry: JSONObject): String = entry.optString("watchedDate").takeIf {
+    runCatching { java.time.LocalDate.parse(it) }.isSuccess
+} ?: Instant.ofEpochMilli(entry.getLong("watchedAt")).atZone(ZoneId.systemDefault()).toLocalDate().toString()
+
+internal fun importedLetterboxdFilm(json: JSONObject): SavedLibraryItem {
+    val id = json.getString("id"); require(letterboxdLookupUrl(id) != null)
+    val name = json.getString("name"); require(name.isNotBlank() && name.length <= 300)
+    return SavedLibraryItem(id, "movie", name, json.optString("poster").takeIf { it.startsWith("https://") }, PosterShape.POSTER,
+        null, null, json.optString("year").takeIf { it.matches(Regex("[0-9]{4}")) }, null, emptyList(), null)
+}
