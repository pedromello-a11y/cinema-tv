+  const d=dom.window.document,$=s=>d.querySelector(s),flush=()=>new Promise(r=>setImmediate(r)),change=(id,value)=>{$(id).value=value;$(id).dispatchEvent(new dom.window.Event('change'))};
+  await flush();$('[data-tab="series"]').click();[...$('#series').querySelectorAll('button')].find(b=>b.textContent==='Corrigir episódios').click();await flush();
+  assert.equal($('#episodes').open,true);assert.equal(posts[0].action,'episodeOpen');
+  change('#epseason','2');change('#epnumber','2:2');assert.equal($('#eptoggle').disabled,true);
+  $('#epthrough').click();assert.ok($('#epcount').textContent.includes('2 episódios'));$('#epcancel').click();assert.equal(posts.length,1);
+  $('#epthrough').click();$('#epconfirm').click();$('#epconfirm').click();await flush();
+  assert.deepEqual(posts[1],{action:'episodeEdit',id:'show',key:'2:2',operation:'THROUGH',expectedKeys:['1:2','2:1']});assert.equal(posts.length,2);
+  assert.equal($('#eptoggle').disabled,true);assert.equal($('#epundo').hidden,false);assert.equal(state.episodeEditor.rows.at(-1).watched,false);
+  $('#epundo').click();await flush();assert.equal(posts.at(-1).action,'episodeUndo');assert.equal($('#epundo').hidden,true);
+  stale=true;change('#epseason','1');change('#epnumber','1:2');$('#eptoggle').click();$('#epconfirm').click();await flush();
+  assert.ok($('#epmessage').textContent.includes('O progresso mudou'));assert.equal($('#epstatus').textContent,'Visto');assert.equal($('#eppreview').hidden,true);
+  $('#epclose').click();await flush();assert.equal($('#episodes').open,false);assert.equal(state.episodeEditor,undefined);
+  assert.deepEqual(errors,[]);console.log('PASS: painel de episódios — abrir, seleção, futuros bloqueados, prévia/cancelar, confirmação única, desfazer, conflito atualizado e fechar.');
+ }finally{dom.window.close()}
+})().catch(e=>{console.error(e);process.exitCode=1});
