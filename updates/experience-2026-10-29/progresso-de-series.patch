@@ -0,0 +1,108 @@
+package com.nuvio.tv.ui.personal
+
+import com.nuvio.tv.core.profile.ProfileManager
+import com.nuvio.tv.data.local.PersonalSeriesPreferences
+import com.nuvio.tv.data.local.WatchedItemsPreferences
+import com.nuvio.tv.domain.model.*
+import com.nuvio.tv.domain.repository.WatchProgressRepository
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import java.time.Instant
+import java.time.ZoneId
+import java.util.UUID
+import javax.inject.Inject
+import javax.inject.Singleton
+
+enum class EpisodeEditAction { WATCHED, UNWATCHED, THROUGH, SEASON }
+data class EpisodeEditorRow(val episode: PersonalEpisode, val watched: Boolean, val released: Boolean)
+data class EpisodeEditorData(val id: String, val name: String, val rows: List<EpisodeEditorRow>, val undoToken: String? = null, val undoLabel: String? = null)
+
+internal fun episodeEditSelection(rows: List<EpisodeEditorRow>, key: String, action: EpisodeEditAction): List<EpisodeEditorRow> {
+    val selected = rows.firstOrNull { it.episode.key == key } ?: error("Episódio não encontrado. Reabra o progresso.")
+    return when(action) {
+        EpisodeEditAction.UNWATCHED -> listOf(selected).filter { it.watched }
+        EpisodeEditAction.WATCHED -> listOf(selected).filter { it.released && !it.watched }
+        EpisodeEditAction.SEASON -> rows.filter { it.released && !it.watched && it.episode.season == selected.episode.season }
+        EpisodeEditAction.THROUGH -> rows.filter { it.released && !it.watched &&
+            (it.episode.season < selected.episode.season || (it.episode.season == selected.episode.season && it.episode.episode <= selected.episode.episode)) }
+    }
+}
+
+/** A single editor service is shared by TV and phone. Writes use the player's existing history path. */
+@Singleton
+class PersonalEpisodeEditor @Inject constructor(
+    private val series: PersonalSeriesPreferences,
+    private val watched: WatchedItemsPreferences,
+    private val progress: WatchProgressRepository,
+    private val profiles: ProfileManager
+) {
+    private val lock = Mutex()
+    private data class Snapshot(val history: Map<Pair<Int,Int>, WatchedItem>, val progress: Map<Pair<Int,Int>, WatchProgress>)
+    private data class Undo(val token: String, val profile: Int, val item: SavedLibraryItem, val episodes: List<PersonalEpisode>,
+        val action: EpisodeEditAction, val before: Snapshot, val after: Snapshot, val label: String)
+    private var undo: Undo? = null
+
+    private fun checkProfile(profile: Int) = check(profiles.activeProfileId.value == profile) { "O perfil mudou. Reabra o progresso." }
+    private suspend fun entry(id: String, profile: Int): PersonalSeriesEntry {
+        checkProfile(profile)
+        return series.observe(profile).first().entries.firstOrNull { it.item.id == id }
+            ?: error("Acompanhe a série para organizar seus episódios.")
+    }
+    private suspend fun snapshot(id: String, profile: Int): Snapshot = Snapshot(
+        watched.observeAllItems(profile).first().filter { it.contentId == id && it.contentType == "series" && it.season != null && it.episode != null }
+            .associateBy { it.season!! to it.episode!! }, progress.getAllEpisodeProgress(id, profile).first())
+    private fun rows(entry: PersonalSeriesEntry, snapshot: Snapshot): List<EpisodeEditorRow> {
+        val now = Instant.now(); val zone = ZoneId.systemDefault()
+        return entry.catalog?.episodes.orEmpty().filter { it.season > 0 && it.episode > 0 }.distinctBy { it.key }
+            .sortedWith(compareBy({ it.season }, { it.episode })).map { ep ->
+                EpisodeEditorRow(ep, (ep.season to ep.episode) in snapshot.history || snapshot.progress[ep.season to ep.episode]?.isCompleted() == true,
+                    personalEpisodeRelease(ep.released, zone)?.let { !it.isAfter(now) } == true)
+            }
+    }
+    private fun data(entry: PersonalSeriesEntry, snapshot: Snapshot, profile: Int): EpisodeEditorData {
+        val pending = undo?.takeIf { it.profile == profile && it.item.id == entry.item.id }
+        return EpisodeEditorData(entry.item.id, entry.item.name, rows(entry, snapshot), pending?.token, pending?.label)
+    }
+    suspend fun load(id: String, profile: Int): EpisodeEditorData = lock.withLock {
+        val entry = entry(id, profile)
+        data(entry, snapshot(id, profile), profile)
+    }
+    private fun completed(item: SavedLibraryItem, ep: PersonalEpisode) = WatchProgress(
+        contentId = item.id, contentType = "series", name = item.name, poster = item.poster, backdrop = item.background, logo = item.logo,
+        videoId = ep.id, season = ep.season, episode = ep.episode, episodeTitle = ep.title,
+        position = 1, duration = 1, lastWatched = System.currentTimeMillis(), addonBaseUrl = item.addonBaseUrl, progressPercent = 100f, completionConfirmed = true)
+    suspend fun apply(id: String, key: String, action: EpisodeEditAction, expectedKeys: List<String>, profile: Int): EpisodeEditorData = lock.withLock {
+        val entry = entry(id, profile)
+        val before = snapshot(id, profile)
+        val selected = episodeEditSelection(rows(entry, before), key, action).map { it.episode }
+        check(selected.map { it.key } == expectedKeys) { "O progresso mudou. Confira a prévia e confirme novamente." }
+        check(selected.isNotEmpty()) { "Nenhum episódio precisa ser alterado." }
+        checkProfile(profile)
+        // Discard the older inverse before a new write; never undo it against a partly changed state.
+        undo = null
+        if(action == EpisodeEditAction.UNWATCHED) progress.removeFromHistoryBatch(id, null, selected.map { Triple(it.season, it.episode, it.id) })
+        else progress.markAsCompletedBatch(selected.map { completed(entry.item, it) })
+        checkProfile(profile)
+        val after = snapshot(id, profile)
+        val label = if(action == EpisodeEditAction.UNWATCHED) "Episódio marcado como não visto" else if(selected.size == 1) "1 episódio marcado como visto" else "${selected.size} episódios marcados como vistos"
+        undo = Undo(UUID.randomUUID().toString(), profile, entry.item, selected, action, before, after, label)
+        data(entry, after, profile)
+    }
+    suspend fun undo(id: String, token: String, profile: Int): EpisodeEditorData = lock.withLock {
+        checkProfile(profile)
+        val last = undo?.takeIf { it.token == token && it.profile == profile && it.item.id == id }
+            ?: error("Esta alteração não pode mais ser desfeita.")
+        val entry = entry(id, profile)
+        val current = snapshot(id, profile)
+        val keys = last.episodes.map { it.season to it.episode }
+        check(keys.all { current.history[it] == last.after.history[it] && current.progress[it] == last.after.progress[it] }) {
+            "Houve uma nova reprodução ou alteração nesses episódios. Confira o progresso antes de corrigir."
+        }
+        undo = null
+        progress.restoreEpisodeStates(id, last.episodes.map { Triple(it.season, it.episode, it.id) },
+            keys.mapNotNull { last.before.progress[it] }, keys.mapNotNull { last.before.history[it] }, profile)
+        checkProfile(profile)
+        data(entry, snapshot(id, profile), profile)
+    }
+}
