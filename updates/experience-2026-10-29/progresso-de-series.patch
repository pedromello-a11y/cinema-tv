+const fs=require('node:fs'),path=require('node:path'),assert=require('node:assert/strict');
+const {JSDOM,VirtualConsole}=require('jsdom');
+(async()=>{
+ const ep=(s,e,watched=false,released=true)=>({episode:{id:`show:${s}:${e}`,season:s,episode:e,title:`Episódio ${e}`},watched,released});
+ const original=[ep(1,1,true),ep(1,2),ep(2,1),ep(2,2,false,false)];
+ const item={id:'show',type:'series',name:'Minha série'};
+ const state={version:'test',availableMB:300,library:{items:[],queueKeys:[]},series:{entries:[{item,mode:'FOLLOWING',label:'Pendentes'}]},history:[],searchResults:[]};
+ const posts=[],errors=[];let stale=false;
+ const dom=new JSDOM(fs.readFileSync(path.join(__dirname,'../app/src/main/assets/personal/phone.html'),'utf8'),{url:'https://cinema.test/',runScripts:'dangerously',pretendToBeVisual:true,virtualConsole:new VirtualConsole().on('jsdomError',e=>errors.push(e.message)),beforeParse(w){
+  w.HTMLDialogElement.prototype.showModal=function(){this.open=true};w.HTMLDialogElement.prototype.close=function(){this.open=false};
+  w.fetch=async(url,options)=>{if(url==='/api/state')return{ok:true,json:async()=>JSON.parse(JSON.stringify(state))};const b=JSON.parse(options.body);posts.push(b);
+   if(b.action==='episodeOpen')state.episodeEditor={id:'show',name:'Minha série',rows:JSON.parse(JSON.stringify(original))};
+   if(b.action==='episodeEdit'){
+    if(stale){state.episodeEditor.rows[1].watched=true;return{ok:false,json:async()=>({error:'O progresso mudou. Confira a prévia e confirme novamente.'})}}
+    state.episodeEditor.rows.forEach(r=>{if(b.expectedKeys.includes(`${r.episode.season}:${r.episode.episode}`))r.watched=b.operation!=='UNWATCHED'});
+    state.episodeEditor.undoToken='undo-1';state.episodeEditor.undoLabel='2 episódios marcados';
+   }
+   if(b.action==='episodeUndo'){assert.equal(b.token,'undo-1');state.episodeEditor.rows=JSON.parse(JSON.stringify(original));delete state.episodeEditor.undoToken;delete state.episodeEditor.undoLabel}
+   if(b.action==='episodeClose')delete state.episodeEditor;
+   return{ok:true,json:async()=>({ok:true})};};
+ }});
