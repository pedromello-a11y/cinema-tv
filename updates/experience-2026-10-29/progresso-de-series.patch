+package com.nuvio.tv.ui.personal
+
+import com.nuvio.tv.core.profile.ProfileManager
+import com.nuvio.tv.data.local.*
+import com.nuvio.tv.domain.model.*
+import com.nuvio.tv.domain.repository.WatchProgressRepository
+import io.mockk.*
+import kotlinx.coroutines.*
+import kotlinx.coroutines.flow.*
+import org.junit.Assert.*
+import org.junit.Before
+import org.junit.Test
+
+class PersonalEpisodeEditorTest {
+    private val profile = MutableStateFlow(1)
+    private val history = MutableStateFlow<List<WatchedItem>>(emptyList())
+    private val playback = MutableStateFlow<Map<Pair<Int,Int>,WatchProgress>>(emptyMap())
+    private lateinit var repository: WatchProgressRepository
+    private lateinit var editor: PersonalEpisodeEditor
+    private var tick = 1000L
+    private fun ep(s: Int, e: Int, release: String? = "2020-01-01") = PersonalEpisode("show:$s:$e", s, e, "Episode $e", release)
+    private fun playing(s: Int, e: Int, position: Long = 40) = WatchProgress("show", "series", "Show", null, null, null, "show:$s:$e", s, e, null, position, 100, 1)
+    @Before fun setup() {
+        val profiles = mockk<ProfileManager>(); every { profiles.activeProfileId } returns profile
+        val series = mockk<PersonalSeriesPreferences>()
+        val item = SavedLibraryItem("show", "series", "Show", null, PosterShape.POSTER, null, null, null, null, emptyList(), null)
+        val entry = PersonalSeriesEntry(item, followedAt = 1, catalog = PersonalSeriesCatalog(listOf(ep(0,1),ep(1,1),ep(1,2),ep(2,1),ep(2,2,"2999-01-01"),ep(2,3,null)), false, 1))
+        every { series.observe(any()) } answers { flowOf(PersonalSeriesSnapshot(firstArg(), listOf(entry), true)) }
+        val watched = mockk<WatchedItemsPreferences>(); every { watched.observeAllItems(any()) } returns history
+        repository = mockk()
+        every { repository.getAllEpisodeProgress("show", any()) } returns playback
+        coEvery { repository.markAsCompletedBatch(any()) } coAnswers {
+            val items = firstArg<List<WatchProgress>>().map { it.copy(position=100,duration=100,progressPercent=100f,completionConfirmed=true,lastWatched=++tick) }
+            playback.value = playback.value + items.associateBy { it.season!! to it.episode!! }
+            val changed = items.map { it.season to it.episode }.toSet()
+            history.value = history.value.filterNot { (it.season to it.episode) in changed } + items.map { WatchedItem(it.contentId,it.contentType,it.name,it.season,it.episode,it.lastWatched) }
+        }
+        coEvery { repository.removeFromHistoryBatch(any(),any(),any()) } coAnswers {
+            val keys=thirdArg<List<Triple<Int,Int,String?>>>().map { it.first to it.second }.toSet()
+            playback.value=playback.value.filterKeys { it !in keys }
+            history.value=history.value.filterNot { (it.season to it.episode) in keys }
+        }
+        coEvery { repository.saveProgressBatch(any(),any()) } coAnswers {
+            playback.value=playback.value+firstArg<List<WatchProgress>>().associateBy { it.season!! to it.episode!! }
+        }
+        coEvery { repository.restoreEpisodeStates(any(),any(),any(),any(),any()) } coAnswers {
+            val keys=secondArg<List<Triple<Int,Int,String?>>>().map { it.first to it.second }.toSet()
+            playback.value=playback.value.filterKeys { it !in keys }+thirdArg<List<WatchProgress>>().associateBy { it.season!! to it.episode!! }
+            history.value=history.value.filterNot { (it.season to it.episode) in keys }+arg<List<WatchedItem>>(3)
+        }
+        editor=PersonalEpisodeEditor(series,watched,repository,profiles)
+    }
+    @Test fun `through preview excludes specials future unknown and previously watched episodes`() = runBlocking {
+        history.value=listOf(WatchedItem("show","series","Show",1,1,99))
+        val rows=editor.load("show",1).rows
+        assertEquals(listOf("1:1","1:2","2:1","2:2","2:3"),rows.map { it.episode.key })
+        assertEquals(listOf("1:2","2:1"),episodeEditSelection(rows,"2:3",EpisodeEditAction.THROUGH).map { it.episode.key })
+        assertEquals(listOf("2:1"),episodeEditSelection(rows,"2:1",EpisodeEditAction.SEASON).map { it.episode.key })
+        assertTrue(episodeEditSelection(rows,"2:2",EpisodeEditAction.WATCHED).isEmpty())
+    }
+    @Test fun `batch changes only previewed keys and undo restores partial playback`() = runBlocking {
+        val partial=playing(1,2)
+        history.value=listOf(WatchedItem("show","series","Show",1,1,99))
+        playback.value=mapOf((1 to 2) to partial,(3 to 1) to playing(3,1))
+        val changed=editor.apply("show","2:1",EpisodeEditAction.THROUGH,listOf("1:2","2:1"),1)
+        assertEquals(99L,history.value.first { it.season==1&&it.episode==1 }.watchedAt)
+        assertEquals(setOf(1 to 1,1 to 2,2 to 1),history.value.map { it.season to it.episode }.toSet())
+        val reverted=editor.undo("show",changed.undoToken!!,1)
+        assertNull(reverted.undoToken)
+        assertEquals(listOf(1 to 1),history.value.map { it.season to it.episode })
+        assertEquals(partial,playback.value[1 to 2])
+        assertEquals(playing(3,1),playback.value[3 to 1])
+    }
+    @Test fun `stale preview is rejected before any write`() = runBlocking {
+        history.value=listOf(WatchedItem("show","series","Show",1,1,99))
+        val result=runCatching { editor.apply("show","1:2",EpisodeEditAction.THROUGH,listOf("1:1","1:2"),1) }
+        assertTrue(result.isFailure)
+        coVerify(exactly=0) { repository.markAsCompletedBatch(any()) }
+    }
+    @Test fun `undo refuses to erase newer playback but allows unrelated changes`() = runBlocking {
+        val changed=editor.apply("show","1:2",EpisodeEditAction.WATCHED,listOf("1:2"),1)
+        playback.value=playback.value+((1 to 2) to playing(1,2,50).copy(lastWatched=5000))
+        assertTrue(runCatching { editor.undo("show",changed.undoToken!!,1) }.isFailure)
+        assertEquals(50L,playback.value[1 to 2]!!.position)
+        coVerify(exactly=0) { repository.removeFromHistoryBatch(any(),any(),any()) }
+    }
+    @Test fun `unwatch can be reversed and tokens cannot be reused or cross profiles`() = runBlocking {
+        history.value=listOf(WatchedItem("show","series","Show",1,1,99))
+        val partial=playing(1,1,40).copy(lastWatched=120)
+        playback.value=mapOf((1 to 1) to partial)
+        val changed=editor.apply("show","1:1",EpisodeEditAction.UNWATCHED,listOf("1:1"),1)
+        assertFalse(changed.rows.first().watched)
+        profile.value=2
+        assertTrue(runCatching { editor.undo("show",changed.undoToken!!,2) }.isFailure)
+        profile.value=1
+        assertTrue(editor.undo("show",changed.undoToken!!,1).rows.first().watched)
+        assertEquals(99L,history.value.single().watchedAt)
+        assertEquals(partial,playback.value[1 to 1])
+        assertTrue(runCatching { editor.undo("show",changed.undoToken!!,1) }.isFailure)
+    }
+    @Test fun `simultaneous confirmations cannot mark the same preview twice`() = runBlocking {
+        val results=(1..2).map { async { runCatching { editor.apply("show","1:2",EpisodeEditAction.WATCHED,listOf("1:2"),1) } } }.awaitAll()
+        assertEquals(1,results.count { it.isSuccess })
+        coVerify(exactly=1) { repository.markAsCompletedBatch(any()) }
+    }
+}
