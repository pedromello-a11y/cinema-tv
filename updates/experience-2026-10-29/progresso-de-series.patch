+                Row(horizontalArrangement = Arrangement.spacedBy(10.dp)) {
+                    if(data?.undoToken != null) CinemaAction("Desfazer", false, Modifier.testTag("episode-undo"), enabled = !state.busy) { onUndo(data.undoToken) }
+                    CinemaAction("Recarregar", false, if(selected == null) Modifier.focusRequester(first) else Modifier.focusRequester(reload), enabled = !state.busy, onClick = onReload)
+                    CinemaAction("Voltar", true, enabled = !state.busy, onClick = onDismiss)
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun EpisodePicker(label: String, modifier: Modifier, enabled: Boolean, change: (Int) -> Unit) {
+    var focused by remember { mutableStateOf(false) }
+    Text(label, fontFamily = CinemaUi, fontSize = 17.sp, color = CinemaStyle.Ink, maxLines = 1, overflow = TextOverflow.Ellipsis,
+        modifier = modifier.onFocusChanged { focused = it.isFocused }.onPreviewKeyEvent { event ->
+            if(event.type != KeyEventType.KeyDown) false else when(event.key) {
+                Key.DirectionLeft -> { if(enabled) change(-1); true }
+                Key.DirectionRight -> { if(enabled) change(1); true }
+                else -> false
+            }
+        }.focusable().border(if(focused) 2.dp else 1.dp, if(focused) CinemaStyle.Green else CinemaStyle.Outline, RoundedCornerShape(12.dp)).padding(14.dp))
+}
