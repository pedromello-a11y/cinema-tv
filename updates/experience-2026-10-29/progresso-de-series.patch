+                        plan(if(selected.watched) EpisodeEditAction.UNWATCHED else EpisodeEditAction.WATCHED)
+                    }
+                    CinemaAction("Já vi até aqui", false, Modifier.testTag("episode-through"), enabled = !state.busy && episodeEditSelection(rows, selected.episode.key, EpisodeEditAction.THROUGH).isNotEmpty()) { plan(EpisodeEditAction.THROUGH) }
+                    CinemaAction("Marcar temporada", false, Modifier.testTag("episode-season-all"), enabled = !state.busy && episodeEditSelection(rows, selected.episode.key, EpisodeEditAction.SEASON).isNotEmpty()) { plan(EpisodeEditAction.SEASON) }
+                }
+            } else {
+                Text(if(state.busy) "Carregando episódios…" else "Os episódios ainda não estão disponíveis. Atualize o acompanhamento da série e reabra esta tela.", fontFamily = CinemaUi, fontSize = 14.sp, lineHeight = 20.sp, color = CinemaStyle.Muted)
