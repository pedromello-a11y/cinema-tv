+package com.nuvio.tv.ui.personal
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.nuvio.tv.core.profile.ProfileManager
+import dagger.hilt.android.lifecycle.HiltViewModel
+import javax.inject.Inject
+import kotlinx.coroutines.*
+import kotlinx.coroutines.flow.*
+
+internal data class EpisodeEditorUiState(val data: EpisodeEditorData? = null, val busy: Boolean = false, val message: String? = null)
+@HiltViewModel
+class PersonalEpisodeEditorViewModel @Inject constructor(private val editor: PersonalEpisodeEditor, private val profiles: ProfileManager) : ViewModel() {
+    private val _state = MutableStateFlow(EpisodeEditorUiState())
+    internal val state = _state.asStateFlow()
+    private var target = ""
+    private var profile = 0
+    internal fun open(id: String) {
+        if(_state.value.busy) return
+        target = id; profile = profiles.activeProfileId.value
+        _state.value = EpisodeEditorUiState()
+        task { editor.load(target, profile) }
+    }
+    internal fun apply(key: String, action: EpisodeEditAction, expected: List<String>) = task { editor.apply(target, key, action, expected, profile) }
+    internal fun undo(token: String) = task { editor.undo(target, token, profile) }
+    private fun task(work: suspend () -> EpisodeEditorData) {
+        if(_state.value.busy) return
+        _state.update { it.copy(busy = true, message = null) }
+        viewModelScope.launch {
+            try { _state.value = EpisodeEditorUiState(data = work()) }
+            catch(e: CancellationException) { throw e }
+            catch(e: Exception) {
+                val refreshed = try { editor.load(target, profile) } catch(cancelled: CancellationException) { throw cancelled } catch(_: Exception) { null }
+                _state.update { it.copy(data = refreshed ?: it.data, message = e.message ?: "Não foi possível alterar. Reabra e confira o progresso.") }
+            }
+            finally { _state.update { it.copy(busy = false) } }
+        }
+    }
+}
